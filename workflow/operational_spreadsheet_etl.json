      ],
      "id": "761db2ac-8d0f-4f16-b1cb-009ce8c74b7f",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "let currentNoId = null;\nlet currentNama = null;\nlet estate = null;\n\nconst output = [];\n\n// 1️ cari estate dulu (sekali saja)\nfor (const item of items) {\n  const row = item.json;\n  for (const v of Object.values(row)) {\n    if (typeof v === 'string' && v.includes(':')) {\n      if (v.toLowerCase().includes('mrbe') || v.toLowerCase().includes('estate')) {\n        estate = v.replace(':', '').trim().toUpperCase();\n        break;\n      }\n    }\n  }\n  if (estate) break;\n}\n\nif (!estate) {\n  throw new Error('Estate tidak ditemukan. Format file salah.');\n}\n\n// 2️ loop normal data + fill down\nfor (const item of items) {\n  const row = item.json;\n\n  if (row['__EMPTY_1']) currentNoId = row['__EMPTY_1'];\n  if (row['__EMPTY_2']) currentNama = row['__EMPTY_2'];\n\n  output.push({\n    ...row,              // JANGAN buang __EMPTY_x\n    estate,              // 👈 estate disuntikkan di sini\n    no_id: currentNoId,\n    nama: currentNama,\n  });\n}\n\nreturn output.map(r => ({ json: r }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1584,
        -128
      ],
      "id": "80d67d68-8f7c-47b1-a6bb-5572d2753bb7",
      "name": "Node 01 - Fill Down Name, No ID, Estate"
    },
    {
      "parameters": {
        "jsCode": "const VALID_METRIC = ['HK', 'JJG', 'KG', 'BRONDOL', 'HA'];\nconst output = [];\n\nfor (const item of items) {\n  const row = item.json;\n\n  const metric = row.__EMPTY_5;\n  const noId = row.no_id;\n  const nama = row.nama;\n\n  //  skip kalau bukan metric valid\n  if (!VALID_METRIC.includes(metric)) continue;\n\n  //  skip kalau belum ada identitas karyawan\n  if (!noId || !nama) continue;\n\n  //  aman, ini data panen beneran\n  output.push({\n    ...row,     // JAGA SEMUA __EMPTY_x (penting buat pivot tanggal)\n    metric\n  });\n}\n\nreturn output.map(r => ({ json: r }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1808,
        -128
      ],
      "id": "16551ae4-36f2-4188-83dd-ab0cf3cc3993",
      "name": "Node 02 - Clean Data and Keep Structure"
    },
    {
      "parameters": {
        "jsCode": "// ===============================\n// 1. Ambil semua row hasil extract\n// ===============================\nconst rows = items.map(i => i.json);\n\n// ===============================\n// 2. Helper: konversi bulan text → angka\n// ===============================\nconst monthMap = {\n  jan: 1, january: 1,\n  feb: 2, february: 2,\n  mar: 3, march: 3,\n  apr: 4, april: 4,\n  may: 5,\n  jun: 6, june: 6,\n  jul: 7, july: 7,\n  aug: 8, august: 8,\n  sep: 9, september: 9,\n  oct: 10, october: 10,\n  nov: 11, november: 11,\n  dec: 12, december: 12,\n};\n\n// ===============================\n// 3. Coba ambil periode dari SHEET\n// ===============================\nlet year = null;\nlet month = null;\nlet periodSource = null;\n\nfor (const row of rows.slice(0, 10)) {\n  for (const val of Object.values(row)) {\n    if (typeof val !== 'string') continue;\n\n    const text = val.toLowerCase();\n\n    // contoh: \"september 2025\", \"sep-25\", \"sep 2025\"\n    for (const [mText, mNum] of Object.entries(monthMap)) {\n      if (text.includes(mText)) {\n        const yearMatch = text.match(/20\\d{2}/);\n        const shortYearMatch = text.match(/\\b\\d{2}\\b/);\n\n        if (yearMatch) {\n          month = mNum;\n          year = Number(yearMatch[0]);\n          periodSource = 'sheet';\n        } else if (shortYearMatch) {\n          month = mNum;\n          year = 2000 + Number(shortYearMatch[0]);\n          periodSource = 'sheet';\n        }\n      }\n    }\n  }\n}\n\n// ===============================\n// 4. Fallback: ambil dari NAMA FILE\n// ===============================\nif (!year || !month) {\n  const fileName =\n    items[0]?.binary?.data?.fileName ||\n    items[0]?.json?.file_name ||\n    '';\n\n  const nameLower = fileName.toLowerCase();\n\n  for (const [mText, mNum] of Object.entries(monthMap)) {\n    if (nameLower.includes(mText)) {\n      const yearMatch = nameLower.match(/20\\d{2}/);\n      if (yearMatch) {\n        month = mNum;\n        year = Number(yearMatch[0]);\n        periodSource = 'filename';\n      }\n    }\n  }\n}\n\n// ===============================\n// 5. VALIDASI (WAJIB)\n// ===============================\nif (!year || !month) {\n  throw new Error(\n    'Periode (bulan & tahun) tidak ditemukan. Pastikan ada di sheet atau nama file.'\n  );\n}\n\n// ===============================\n// 6. Return metadata ke semua item\n// ===============================\nreturn items.map(item => ({\n  json: {\n    ...item.json,\n    year,\n    month,\n    period_source: periodSource\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        -128
      ],
      "id": "02302407-70e1-43f1-85db-9721fec31978",
      "name": "Node 0 - Extract and Fill Month and Year"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of items) {\n  const row = item.json;\n\n  const {\n    estate,\n    no_id,\n    nama,\n    metric,\n    year,\n    month,\n  } = row;\n\n  // loop semua kolom\n  for (const [key, value] of Object.entries(row)) {\n    // hanya kolom tanggal (__EMPTY_x) & value angka\n    if (!key.startsWith('__EMPTY_')) continue;\n    if (typeof value !== 'number') continue;\n    if (value === 0) continue; // skip nol (opsional)\n    //if (value === null || value === undefined || value === \"\") continue;\n    \n    const colIndex = Number(key.replace('__EMPTY_', ''));\n    if (isNaN(colIndex)) continue;\n\n    // mapping index ke day\n    const day = colIndex - 5; // __EMPTY_6 = tgl 1\n\n    if (day < 1 || day > 31) continue;\n\n    output.push({\n      estate,\n      no_id,\n      nama,\n      metric,\n      year,\n      month,\n      day,\n      value,\n    });\n  }\n}\n\nreturn output.map(r => ({ json: r }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        112
      ],
      "id": "a15ebf99-ffc3-4dda-b833-883882ea715c",
      "name": "Node 3 -Unpivot Tanggal"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  return {\n    json: {\n      ...item.json,\n      uploaded_at: new Date().toISOString()\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        112
      ],
      "id": "669efa44-2075-49a7-b7be-a355b5764a63",
      "name": "Add Uploaded Timestamp"
    },
    {
      "parameters": {
        "jsCode": "const required = [\"estate\",\"no_id\",\"nama\",\"metric\",\"year\",\"month\",\"day\",\"value\"];\n\nreturn items.map(item => {\n  const r = item.json;\n  const errors = [];\n  const warnings = [];\n\n  // Required fields\n  for (const f of required) {\n    if (r[f] === undefined || r[f] === null || r[f] === \"\") {\n      errors.push(`Missing field: ${f}`);\n    }\n  }\n\n  // Type checks\n  if (r.value !== undefined && (isNaN(Number(r.value)))) {\n    errors.push(`Value not numeric: ${r.value}`);\n  }\n\n  // Negative check\n  if (Number(r.value) < 0) {\n    errors.push(`Negative value: ${r.value}`);\n  }\n\n  // Date sanity\n  const d = new Date(r.year, r.month-1, r.day);\n  if (isNaN(d.getTime())) {\n    errors.push(`Invalid date: ${r.year}-${r.month}-${r.day}`);\n  }\n\n  // Example soft rule (optional)\n  // Kalau metric JJG tapi value 0 → warning saja\n  if (r.metric === \"JJG\" && Number(r.value) === 0) {\n    warnings.push(`JJG is zero`);\n  }\n\n  const is_valid = errors.length === 0;\n\n  return {\n    json: {\n      ...r,\n      is_valid,\n      validation_errors: errors.join(\"; \"),\n      validation_warnings: warnings.join(\"; \"),\n      validated_at: new Date().toISOString()\n    }\n  };\n});\n"
      },
